{
    "name": "timelogic-api/php-sdk",
    "description": "TimeLogic API | A World Time API",
    "keywords": [
        "time",
        "timezone",
        "world-time",
        "php",
        "sdk",
        "rest",
        "api",
        "rapidapi"
    ],
    "homepage": "https://api.timelogicapi.com",
    "license": "Unlicense",
    "authors": [
        {
            "name": "TimeLogic API LLC",
            "homepage": "https://timelogicapi.com"
        }
    ],
    "support": {
        "issues": "https://github.com/TimeLogic-API-LLC/timelogic-api-sdks/issues",
        "source": "https://github.com/TimeLogic-API-LLC/timelogic-api-sdks"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.16.1 || ^8.3.1",
        "guzzlehttp/psr7": "^2.13.2 || ^3.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.33",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "TimeLogic\\Api\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TimeLogic\\Api\\Test\\": "test/"
        }
    }
}
